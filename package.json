{
  "name": "@milesverse/sdk",
  "version": "0.1.0",
  "description": "MilesVerse JavaScript SDK: token exchange against a registered platform application, silent refresh, and a typed client for the catalogue, sessions and progress APIs. Framework-agnostic — Angular, React, or plain fetch environments.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MilesEducation-Tech/milesverse-backend.git",
    "directory": "sdk"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
